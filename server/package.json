{
  "name": "personal-library-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/index.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "owner-password": "node src/password.mjs",
    "storage:dev": "node --env-file-if-exists=.env src/dev-storage.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "file-type": "^21.0.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.0",
    "sharp": "^0.34.0",
    "yauzl": "^3.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "s3rver": "^3.7.1"
  }
}
