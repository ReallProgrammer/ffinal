# Backend-only configuration. Never copy these values into VITE_* variables.
DATABASE_URL=postgresql://library:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:15432/library
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
S3_REGION=us-east-1
S3_BUCKET=personal-library
# Omit for AWS S3; set an HTTPS endpoint for another S3-compatible provider.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OWNER_EMAIL=
# Generate with npm run owner-password (reads the password from stdin).
OWNER_PASSWORD_HASH=
FRONTEND_ORIGINS=https://reallprogrammer.github.io
PORT=8787
HOST=0.0.0.0
NODE_ENV=production
# Set only to the known number of trusted reverse proxies in front of this API.
TRUST_PROXY_HOPS=0
# Production buckets must already exist and block public access.
S3_CREATE_BUCKET=false
