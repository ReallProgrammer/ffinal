# Backend-only configuration. Never copy these values into VITE_* variables.
DATABASE_URL=postgresql://library:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:15432/library
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
S3_REGION=us-east-1
S3_BUCKET=personal-library
# Omit for AWS S3; set an HTTPS endpoint for another S3-compatible provider.
S3_ENDPOINT=
# Railway's new buckets use false. Legacy buckets/local emulator may require true.
# If omitted, custom endpoints default to true; AWS defaults to false.
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public sign-in alias; existing owner password still applies.
OWNER_USERNAME=x0Arghad
OWNER_EMAIL=
# Generate with npm run owner-password (reads the password from stdin).
OWNER_PASSWORD_HASH=
FRONTEND_ORIGINS=https://reallprogrammer.github.io
PORT=8787
HOST=0.0.0.0
NODE_ENV=production
# Set only to the known number of trusted reverse proxies in front of this API.
TRUST_PROXY_HOPS=0
# Production buckets must already exist and block public access.
S3_CREATE_BUCKET=false

# Optional owner chess phone alerts. Generate once with: npx web-push generate-vapid-keys --json
# Keep the private key backend-only. Dashboard matches work without these.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Preferred phone alerts: create a bot with Telegram @BotFather, then message it /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Production value: https://reallprogrammer.github.io/ffinal/
CHESS_SITE_URL=
